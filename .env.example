# Copy to .env for local dev (vercel dev picks it up automatically).
# In production, set this in the Vercel project's Environment Variables — never commit a real value.

# Which provider api/analyze.js actually calls: "anthropic" (default), "openai",
# or "n8n" (delegates the AI call itself to an n8n workflow via webhook).
# All can be set at once — this is just the switch.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5   (optional override, this is the default)

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini          (optional override, this is the default)

# Only used when AI_PROVIDER=n8n. Point this at an n8n Webhook-trigger node.
# We POST { system, user, maxTokens }; your workflow should feed system+user
# into an AI node of your choice and "Respond to Webhook" with
# { "text": "<raw AI text output>" } — same shape our own JSON prompts expect.
N8N_ANALYZE_WEBHOOK_URL=

# Optional. When a CSM clicks "Approve & Send to Workflow" on a Next Best
# Action, we POST { accountId, accountName, csmName, action, category,
# rationale, reviewedByHuman, approvedAt } here. Wire your own downstream
# steps in n8n (Sheet log, internal notification). If unset, approvals are
# just logged server-side so the approve flow still works without n8n
# configured.
N8N_APPROVAL_WEBHOOK_URL=

# Separate, explicit opt-in for actually reaching the outside world — a
# configured N8N_APPROVAL_WEBHOOK_URL above is NOT enough by itself.
# MOCK_AI only ever mocks AI calls (api/analyze.js); it has no effect here.
#   Safe local/test mode (default): ENABLE_EXTERNAL_ACTIONS unset or "false"
#     → approvals are always just logged server-side, no real n8n call,
#       no real email, no real Sheet row — even if a webhook URL is set.
#   Intentional live-demo mode: ENABLE_EXTERNAL_ACTIONS=true
#     → requires the exact string "true" — plus a valid N8N_APPROVAL_WEBHOOK_URL
#       and N8N_WEBHOOK_SECRET below — to actually call the real workflow.
ENABLE_EXTERNAL_ACTIONS=false

# Required if EITHER n8n webhook URL above is set — the app sends this value
# as the "x-cs-ai-hub-secret" request header on every outbound n8n call; set
# up a matching n8n Header Auth credential with that exact header name (see
# docs/11_n8n_hardening_runbook.md). If a webhook URL is configured but this
# is missing, the app refuses to call it and returns a config error instead —
# it never calls an unauthenticated webhook. Never logged, never sent to the
# browser.
N8N_WEBHOOK_SECRET=

# Optional, advanced: override the default outbound n8n timeouts (ms). The
# analyze webhook gets more time (an LLM call can be slow); the approval
# webhook stays short since it is never automatically retried. Leave unset
# to use the defaults (25000 / 8000).
# N8N_ANALYZE_TIMEOUT_MS=25000
# N8N_APPROVAL_TIMEOUT_MS=8000

# Comma-separated list of origins allowed to call the /api/* endpoints.
# Example: http://localhost:5173,https://account-health-copilot.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to "true" to skip real Anthropic API calls entirely and return
# canned mock responses instead — for local dev/demo without spending
# real API tokens. Leave unset (or "false") for real AI calls.
MOCK_AI=false

# Account storage: json for an offline fixture; supabase for the connected Hub.
# Supabase errors never silently fall back to the JSON fixture.
ACCOUNT_DATA_SOURCE=json
SUPABASE_URL=
# Server-side secret key (or legacy service_role key), NEVER a frontend key.
SUPABASE_SECRET_KEY=
