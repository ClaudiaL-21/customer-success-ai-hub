{
  "functions": {
    "api/accounts.js": {
      "includeFiles": "data/**"
    },
    "api/analyze.js": {
      "includeFiles": "data/**"
    },
    "api/approve-action.js": {
      "includeFiles": "data/**"
    },
    "api/qbr-export.js": {
      "includeFiles": "{data/**,assets/logo-horizontal-light.png,assets/qbr-master/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; connect-src 'self'; img-src 'self' https://*.tile.openstreetmap.org data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
